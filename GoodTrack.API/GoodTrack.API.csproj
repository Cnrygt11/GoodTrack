<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cd547d3b-47f6-4ebe-8330-727189162580</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.4" />
    <!-- DataProtection.EntityFrameworkCore 9.0.4, System.Security.Cryptography.Xml 9.0.4'ü
         transitive getiriyor; o sürüm NU1903 (GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf,
         high) açığını taşıyor. Yamalı 10.0.9'a pinliyoruz. NU1510: net10 pruning bu paketi
         "gereksiz" sanıyor ancak yamalı transitive'i zorlamak için pin GEREKLİ. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" NoWarn="NU1510" />
    <!-- Pinned to a patched 2.x to resolve NU1903 (GHSA-v5pm-xwqc-g5wc) while staying
         API-compatible with Microsoft.AspNetCore.OpenApi 10.0.8 (3.x breaks its source generator). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
